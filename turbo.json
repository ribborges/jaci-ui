{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "clean": {
      "cache": false
    },
    "@jaci-ui/fixture-react-router#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@jaci-ui/fixture-react-router#check": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
