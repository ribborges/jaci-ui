{
  "name": "jaci-ui-workspace",
  "description": "Workspace for the Jaci UI React component library",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Richard de Carvalho Borges",
    "email": "contato@richardborges.dev",
    "url": "https://richardborges.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ribborges/jaci-ui.git"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "rimraf .turbo .artifacts .fixture-pack-check packages/ui/dist packages/ui/src/styled-system packages/ui/tsconfig.tsbuildinfo apps/storybook/storybook-static apps/storybook/tsconfig.tsbuildinfo fixtures/vite/dist fixtures/vite/tsconfig.tsbuildinfo fixtures/react18/dist fixtures/react18/tsconfig.tsbuildinfo fixtures/react-router/tsconfig.tsbuildinfo fixtures/next/.next fixtures/next/tsconfig.tsbuildinfo",
    "dev": "turbo run dev --parallel --filter=jaci-ui --filter=@jaci-ui/storybook --filter=@jaci-ui/fixture-vite --filter=@jaci-ui/fixture-next",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter jaci-ui build && pnpm --filter @jaci-ui/storybook dev",
    "storybook:build": "pnpm --filter jaci-ui build && pnpm --filter @jaci-ui/storybook build",
    "package:check": "pnpm --filter jaci-ui package:check",
    "fixtures:check": "turbo run check --filter=@jaci-ui/fixture-next --filter=@jaci-ui/fixture-react-router --filter=@jaci-ui/fixture-vite --filter=@jaci-ui/fixture-react18",
    "fixtures:pack-check": "node scripts/check-packed-fixtures.mjs",
    "changeset": "changeset",
    "release:version": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
